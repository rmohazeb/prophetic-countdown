import React, { useState, useEffect, useRef, useCallback } from 'react';
import { HashRouter, Routes, Route, NavLink, useLocation } from 'react-router-dom';

// ============================================================
// ASSET PATH HELPER — Uses Vite's import.meta.env.BASE_URL
// ============================================================
const getAssetPath = (filename: string): string => {
  const base = import.meta.env.BASE_URL || '';
  return `${base}/${filename.toLowerCase()}`;
};

// ============================================================
// ROUTE DATA — navLabel for navigation, pageTitle for page h1
// ============================================================
interface RouteData {
  path: string;
  navLabel: string;
  pageTitle: string;
  bgColor: string;
  images: string[];
  pdfs: { filename: string; label: string }[];
  isFulfilled: boolean;
  targetDate?: Date;
  timestamp?: string;
  fulfilledDate?: string;
}

