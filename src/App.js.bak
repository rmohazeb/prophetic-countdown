`;

// ============================================================
// COUNTDOWN COMPONENT — PURE DISPLAY, no buttons
// ============================================================
function Countdown({ targetDate }) {
  const [timeLeft, setTimeLeft] = useState({ years: 0, days: 0, hours: 0, minutes: 0, seconds: 0 });

  useEffect(() => {
    const calculate = () => {
      const now = new Date().getTime();
      const target = targetDate.getTime();
      const diff = target - now;

      if (diff <= 0) {
        setTimeLeft({ years: 0, days: 0, hours: 0, minutes: 0, seconds: 0 });
        return;
      }

      const years = Math.floor(diff / (1000 * 60 * 60 * 24 * 365.25));
      const days = Math.floor((diff % (1000 * 60 * 60 * 24 * 365.25)) / (1000 * 60 * 60 * 24));
      const hours = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
      const minutes = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
      const seconds = Math.floor((diff % (1000 * 60)) / 1000);

      setTimeLeft({ years, days, hours, minutes, seconds });
    };

    calculate();
    const interval = setInterval(calculate, 1000);
    return () => clearInterval(interval);
  }, [targetDate]);

  return (
    <>
      <div className="countdown-unit">
        <span className="countdown-digit">{timeLeft.years}</span>
        <span className="countdown-label">Years</span>
      </div>
      <div className="countdown-unit">
        <span className="countdown-digit">{timeLeft.days}</span>
        <span className="countdown-label">Days</span>
      </div>
      <div className="countdown-unit">
        <span className="countdown-digit">{timeLeft.hours}</span>
        <span className="countdown-label">Hours</span>
      </div>
      <div className="countdown-unit">
        <span className="countdown-digit">{timeLeft.minutes}</span>
        <span className="countdown-label">Minutes</span>
      </div>
      <div className="countdown-unit">
        <span className="countdown-digit">{timeLeft.seconds}</span>
        <span className="countdown-label">Seconds</span>
      </div>
    </>
  );
}

// ============================================================
// FULFILLED COMPONENT
// ============================================================
function Fulfilled() {
  return (
    <div className="fulfilled-container">
      <div className="fulfilled-box">
        <span className="fulfilled-text">FULFILLED</span>
      </div>
      <div className="fulfilled-check">
        <span>&#10003;</span>
      </div>
    </div>
  );
}

// ============================================================
// PROPHECY PAGE COMPONENT
// ============================================================
function ProphecyPage({ route, soundEnabled, audioUnlocked, audioRef, onToggleSound }) {
  // Audio playback inside interval for future prophecies
  useEffect(() => {
    if (route.isFulfilled) return;

    const interval = setInterval(() => {
      if (soundEnabled === true && audioUnlocked === true && audioRef.current) {
        audioRef.current.currentTime = 0;
        audioRef.current.play().catch(() => {});
      }
    }, 1000);

    return () => clearInterval(interval);
  }, [route.isFulfilled, soundEnabled, audioUnlocked, audioRef]);

  return (
    <div>
      <h1 className="page-title">{route.pageTitle}</h1>

      {/* UTC Timestamp for future prophecies */}
      {route.timestamp && (
        <div className="utc-timestamp">{route.timestamp}</div>
      )}

      {/* Fulfilled date for past prophecies */}
      {route.isFulfilled && route.fulfilledDate && (
        <div className="fulfilled-date">{route.fulfilledDate}</div>
      )}

      {/* Countdown or Fulfilled */}
      {!route.isFulfilled && route.targetDate ? (
        <div className="countdown-row">
          <Countdown targetDate={route.targetDate} />
          {/* Sound toggle — FINAL element in countdown row, rendered EXACTLY ONCE per future prophecy page */}
          <button className="snd-btn" onClick={onToggleSound}>
            {soundEnabled ? 'Turn Sound OFF' : 'Turn Sound ON'}
          </button>
        </div>
      ) : (
        <>
          <Fulfilled />
        </>
      )}

      {/* Imagery Section */}
      <h2 className="section-heading">Imagery</h2>
      <div className="image-grid">
        {route.images.map((img, idx) => (
          <img
            key={idx}
            src={getAssetPath(img)}
            alt={`${route.navLabel} image ${idx + 1}`}
            loading="lazy"
          />
        ))}
      </div>

      {/* Signs & Proofs Section */}
      <h2 className="section-heading">Signs &amp; Proofs</h2>
      <div className="pdf-cards">
        {route.pdfs.map((pdf, idx) => (
          <a
            key={idx}
            href={getAssetPath(pdf.filename)}
            target="_blank"
            rel="noopener noreferrer"
            className="pdf-card"
          >
            {pdf.label}
          </a>
        ))}
      </div>
    </div>
  );
}

// ============================================================
// HOMEPAGE COMPONENT
// ============================================================
function HomePage() {
  const homeRoute = routeData[0];

  return (
    <div>
      <h1 className="page-title">{homeRoute.pageTitle}</h1>
      <div className="subheading-yellow">Are You Ready? Time Is Running Out!</div>
      <div className="subheading-blue">Comments? Use:: AmazingQuran19@gmail.com</div>

      {/* Imagery Section */}
      <h2 className="section-heading">Imagery</h2>
      <div className="image-grid">
        {homeRoute.images.map((img, idx) => (
          <img
            key={idx}
            src={getAssetPath(img)}
            alt={`Homepage image ${idx + 1}`}
            loading="lazy"
          />
        ))}
      </div>

      {/* Signs & Proofs Section */}
      <h2 className="section-heading">Signs &amp; Proofs</h2>
      <div className="pdf-cards">
        {homeRoute.pdfs.map((pdf, idx) => (
          <a
            key={idx}
            href={getAssetPath(pdf.filename)}
            target="_blank"
            rel="noopener noreferrer"
            className="pdf-card"
          >
            {pdf.label}
          </a>
        ))}
      </div>
    </div>
  );
}

// ============================================================
// MAIN APP COMPONENT
// ============================================================
function AppContent() {
  const location = useLocation();
  const audioRef = useRef(null);
  const [soundEnabled, setSoundEnabled] = useState(false);
  const [audioUnlocked, setAudioUnlocked] = useState(false);

  // Determine active route background color
  const activeRoute = routeData.find(r => r.path === location.pathname) || routeData[0];
  const activeRouteColor = activeRoute.bgColor;

  // Audio unlock on first click (one-time)
  useEffect(() => {
    const handleFirstClick = () => {
      if (audioRef.current) {
        audioRef.current.play().then(() => {
          audioRef.current.pause();
          setAudioUnlocked(true);
        }).catch(() => {});
      }
      document.removeEventListener('click', handleFirstClick);
    };
    document.addEventListener('click', handleFirstClick);
    return () => document.removeEventListener('click', handleFirstClick);
  }, []);

  const toggleSound = useCallback(() => {
    setSoundEnabled(prev => !prev);
  }, []);

  return (
    <div className="app-container" style={{ backgroundColor: activeRouteColor }}>
      <style>{globalStyles}</style>

      {/* Audio element — preload auto */}
      <audio ref={audioRef} preload="auto" src={getAssetPath('tick_tock_sound2.mp3')} />

      {/* Navigation — 8 bordered links */}
      <nav className="nav-container">
        {routeData.map((route) => (
          <NavLink
            key={route.path}
            to={route.path}
            end={route.path === '/'}
            className={({ isActive }) =>
              `nav-link${isActive ? ' active' : ''}`
            }
          >
            {route.navLabel}
          </NavLink>
        ))}
      </nav>

      {/* Routes */}
      <Routes>
        <Route path="/" element={<HomePage />} />
        <Route path="/resurrection" element={
          <ProphecyPage
            route={routeData[1]}
            soundEnabled={soundEnabled}
            audioUnlocked={audioUnlocked}
            audioRef={audioRef}
            onToggleSound={toggleSound}
          />
        } />
        <Route path="/gog-magog" element={
          <ProphecyPage
            route={routeData[2]}
            soundEnabled={soundEnabled}
            audioUnlocked={audioUnlocked}
            audioRef={audioRef}
            onToggleSound={toggleSound}
          />
        } />
        <Route path="/day-of-smoke" element={
          <ProphecyPage
            route={routeData[3]}
            soundEnabled={soundEnabled}
            audioUnlocked={audioUnlocked}
            audioRef={audioRef}
            onToggleSound={toggleSound}
          />
        } />
        <Route path="/computer" element={
          <ProphecyPage
            route={routeData[4]}
            soundEnabled={soundEnabled}
            audioUnlocked={audioUnlocked}
            audioRef={audioRef}
            onToggleSound={toggleSound}
          />
        } />
        <Route path="/moon" element={
          <ProphecyPage
            route={routeData[5]}
            soundEnabled={soundEnabled}
            audioUnlocked={audioUnlocked}
            audioRef={audioRef}
            onToggleSound={toggleSound}
          />
        } />
        <Route path="/messenger" element={
          <ProphecyPage
            route={routeData[6]}
            soundEnabled={soundEnabled}
            audioUnlocked={audioUnlocked}
            audioRef={audioRef}
            onToggleSound={toggleSound}
          />
        } />
        <Route path="/quran-19" element={
          <ProphecyPage
            route={routeData[7]}
            soundEnabled={soundEnabled}
            audioUnlocked={audioUnlocked}
            audioRef={audioRef}
            onToggleSound={toggleSound}
          />
        } />
      </Routes>
    </div>
  );
}

// ============================================================
// APP — Wrapped in HashRouter
// ============================================================
function App() {
  return (
    <HashRouter>
      <AppContent />
    </HashRouter>
  );
}

export default App;
